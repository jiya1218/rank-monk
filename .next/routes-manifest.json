    },
    {
      "page": "/api/brand/extract",
      "regex": "^/api/brand/extract(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/brand/extract(?:/)?$"
    },
    {
      "page": "/api/checkout/create-order",
      "regex": "^/api/checkout/create\\-order(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/checkout/create\\-order(?:/)?$"
    },
    {
      "page": "/api/checkout/verify",
      "regex": "^/api/checkout/verify(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/checkout/verify(?:/)?$"
    },
    {
      "page": "/comparison",
      "regex": "^/comparison(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/comparison(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/pricing",
      "regex": "^/pricing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pricing(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
